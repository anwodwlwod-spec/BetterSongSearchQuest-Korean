<!-- old preferred-width="130"  anchor-pos-y="10.5" anchor-min-y="0"  -->
<vertical preferred-width="130" anchor-min-y="1" child-control-height="false" xmlns:xsi='http://www.w3.org/2001/XMLSchema-instance' xsi:noNamespaceSchemaLocation='https://raw.githubusercontent.com/RedBrumbler/Quest-BSML-Docs/gh-pages/schema.xsd'>
	<horizontal bg='panel-top-gradient' id='filterbarContainer' child-align='MiddleRight' child-control-width='false'>
		<horizontal ignore-layout='true' pad-top='-1'>
			<text text='검색 필터' align='Center' font-size='7' italics='true'/>
		</horizontal>
		<horizontal horizontal-fit='PreferredSize' spacing='2' pad-right='1'>
			<button text='초기화' on-click='ClearFilters' pref-width="15" />
			<button text='프리셋' on-click='ShowPresets' pref-width="15" />
		</horizontal>
	</horizontal>
	<!-- <macro.as-host host='currentFilter'> -->
		<horizontal horizontal-fit='PreferredSize' pad='4' spacing='2' preferred-height='79' child-control-height='false'>
			<vertical spacing='2'>
				<vertical child-control-height='false' bg='panel-top' pad='2' pad-bottom='1' pad-top='1' preferred-width='64'>
					<text text='&lt;color=#DDD>일반' align='Center' underlined='true' bold='true' font-size='3.5' color='#69B' size-delta-y='5'/>
					<list-setting id="existingSongsSetting" text='다운로드 여부' value="existingSongs" choices='downloadedFilterOptions' bind-value="true" apply-on-change="true" on-change="UpdateFilterSettings"/>
					<list-setting id="existingScoreSetting" text='로컬 점수' value="existingScore" choices='scoreFilterOptions' bind-value="true" apply-on-change="true" on-change="UpdateFilterSettings"/>
					<slider-setting id="minimumSongLengthSlider" text='길이' value="minimumSongLength" bind-value="true" apply-on-change="true" max='10' increment='0.25' formatter='FormatSongLengthLimitFloat' on-change="UpdateFilterSettings"/>
					<slider-setting id="maximumSongLengthSlider" text='MERGE_TO_PREV' value="maximumSongLength" bind-value="true" apply-on-change="true" max='15' increment='0.25' formatter='FormatSongLengthLimitFloat' on-change="UpdateFilterSettings"/>
				</vertical>
				<vertical child-control-height='false' bg='panel-top' pad='2' pad-bottom='1' pad-top='1' preferred-width='64'>
					<text text='&lt;color=#DDD>매핑' align='Center' underlined='true' bold='true'  font-size='3.5' color='#69B' size-delta-y='5'/>
					<slider-setting id="minimumNjsSlider" text='NJS' value="minimumNjs" bind-value="true" apply-on-change="true" max='25' increment='0.5' formatter='FormatShortFloat' on-change="UpdateFilterSettings"/>
					<slider-setting id="maximumNjsSlider" text='MERGE_TO_PREV' value="maximumNjs" bind-value="true" apply-on-change="true" max='25' increment='0.5' formatter='FormatMaxNjs' on-change="UpdateFilterSettings"/>
					<slider-setting id="minimumNpsSlider" text='초당 노트' value="minimumNps" bind-value="true" apply-on-change="true" max='12' increment='0.5' formatter='FormatShortFloat' on-change="UpdateFilterSettings"/>
					<slider-setting id="maximumNpsSlider" text='MERGE_TO_PREV' value="maximumNps" bind-value="true" apply-on-change="true" max='12' increment='0.5' formatter='FormatMaxNps' on-change="UpdateFilterSettings"/>
				</vertical>
				<vertical child-control-height='false' bg='panel-top' pad='2' pad-bottom='1' pad-top='1' preferred-width='64'>
					<text text='&lt;color=#DDD>랭크' align='Center' underlined='true' bold='true' font-size='3.5' color='#69B' size-delta-y='5'/>
					<dropdown-list-setting id='rankedStateSetting' text='랭크 상태' value="rankedState" apply-on-change="true" bind-value="true" choices='rankedFilterOptions' on-change="UpdateFilterSettings"/>
					<slider-setting id="minStarsSetting" text='별점' value="minimumStars" bind-value="true" apply-on-change="true" max='18' increment='0.2' formatter='FormatShortFloat' on-change="UpdateFilterSettings"/>
					<slider-setting id="maxStarsSetting" text='MERGE_TO_PREV' value="maximumStars" bind-value="true" apply-on-change="true" max='18' increment='0.2' formatter='FormatMaxStarsFloat' on-change="UpdateFilterSettings"/>
				</vertical>
			</vertical>
			<vertical spacing='2'>
				<vertical child-control-height='false' bg='panel-top' pad-top='1' preferred-width='64' pad-bottom='29' vertical-fit='PreferredSize'>
					<text text='&lt;color=#DDD>비트세이버' align='Center' underlined='true' bold='true' font-size='3.5' color='#69B' size-delta-y='5'/>
					<scroll-view ignore-layout='true' size-delta-x='2' size-delta-y='-2' anchor-min-y='-0.2' anchor-max-y='0.8' anchor-max-x="1.09">
						<vertical child-control-height='false' preferred-width='60' vertical-fit='PreferredSize' pad-left='1' pad-right='-2'>
							<slider-setting text='최소 등록일' id='hideOlderThanSlider' value="hideOlderThan"  bind-value="true" apply-on-change="true" min="0" max='2' increment='1' formatter='DateTimeToStr' on-change="UpdateFilterSettings"/>
							<slider-setting id="minimumRatingSlider" text='최소 평점' value="minimumRating" bind-value="true" apply-on-change="true" max='0.9' increment='0.05' formatter='PercentFloat' on-change="UpdateFilterSettings"/>
							<slider-setting text='최소 투표 수' id='minimumVotesSlider' value="minimumVotes" bind-value="true" apply-on-change="true" increment='1' max='100' on-change="UpdateFilterSettings"/>
							<string-setting text='업로더' id='uploadersStringControl' value='uploadersString' bind-value='true' apply-on-change='true' on-change="UpdateFilterSettings" hover-hint='여러 업로더 이름을 공백으로 구분해 입력할 수 있습니다. 입력 맨 앞에 느낌표(!)를 붙이면 해당 업로더들을 제외하는 블랙리스트로 작동합니다'/>
							<dropdown-list-setting text='맵 스타일' id='mapStyleDropdown' value="mapStyleString" apply-on-change="true" bind-value="true" choices='mapStyles' formatter='FormatBeatSaverTag' on-change="UpdateFilterSettings"/>
							<horizontal pad-right="-3">
								<text text="곡 장르" align="MidlineLeft" italics="true"/>
								<button id='genrePickButton' text="전체" preferred-width="29" on-click="ShowGenrePicker" all-uppercase="false"/>
							</horizontal>
							<checkbox-setting id="onlyCuratedMapsToggle" value="onlyCuratedMaps" text="큐레이션 맵만" bind-value='true' apply-on-change='true' on-change="UpdateFilterSettings" />
							<checkbox-setting id="onlyVerifiedMappersToggle" value="onlyVerifiedMappers" text="인증 매퍼만" bind-value='true' apply-on-change='true' on-change="UpdateFilterSettings"/>
							<checkbox-setting id="onlyV3MapsToggle" value="onlyV3Maps" text="V3 맵만" bind-value='true' apply-on-change='true' on-change="UpdateFilterSettings"/>
						</vertical>
					</scroll-view>
				</vertical>
				<vertical child-control-height='false' bg='panel-top' pad='2' pad-bottom='1' pad-top='1' preferred-width='64'>
					<text text='&lt;color=#DDD>특성 / 난이도' align='Center' underlined='true' bold='true' font-size='3.5' color='#69B' size-delta-y='5'/>
					<dropdown-list-setting id="characteristicDropdown" text='특성' value="characteristic" apply-on-change="true" bind-value="true" choices='characteristics' on-change="UpdateFilterSettings"/>
					<dropdown-list-setting id="difficultyDropdown" text='난이도' value="difficulty" apply-on-change="true" bind-value="true" choices='difficulties' on-change="UpdateFilterSettings"/>
				</vertical>
				<vertical child-control-height='false' bg='panel-top' pad='2' pad-bottom='1' pad-top='1' preferred-width='64'>
					<text text='&lt;color=#DDD>모드' align='Center' underlined='true' bold='true' font-size='3.5' color='#69B' size-delta-y='5'/>
					<dropdown-list-setting id='modsRequirementDropdown' text='요구 모드' value="mods" apply-on-change="true" bind-value="true" choices='modOptions' on-change="UpdateFilterSettings"/>
				</vertical>
			</vertical>
		</horizontal>
	<!-- </macro.as-host> -->

	<horizontal>
		<horizontal preferred-width="65" child-expand-width="false" spacing='2' child-align='MiddleCenter'>
			<text id="versionLabel" text="~version" font-size="3" font-color="#CC6E3B" align="Center"/>
			<!-- <clickable-text text='♥ Donate' font-size="4" align="Center"  on-click="OpenSponsorsModal"/> -->
		</horizontal>
		<horizontal preferred-width="65">
			<clickable-text id="datasetInfoLabel" font-size="3" font-color="#CCC" text="데이터셋 불러오는 중..." align="Center"  on-click="TryToDownloadDataset"/>
		</horizontal>
	</horizontal>

	<bg>
		<modal size-delta-x='80' size-delta-y='88' move-to-center="true" id="sponsorModal">
			<vertical horizontal-fit='Unconstrained' pad='2' pad-top='9'>
				<horizontal bg='panel-top-gradient' ignore-layout='true' anchor-max-x='.97' anchor-min-x='.03' anchor-min-y='1' anchor-pos-y='-5'>
					<text text='향상된 곡 검색 - 후원' align='Center'/>
				</horizontal>
				<text text='이 프로젝트를 즐기고 계신가요? 제작자를 후원할 수 있습니다.' align='Center'/>
				<horizontal>
					<primary-button text='웹사이트 열기' on-click='OpenSponsorsLink'/>
					<button text='닫기' on-click='CloseSponsorModal'/>
				</horizontal>
			</vertical>
		</modal>
	</bg>
</vertical>

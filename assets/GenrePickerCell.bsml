<horizontal child-expand-width='false' child-align='MiddleLeft' spacing='2'>
	<clickable-text id='includeButton' font-size='3.5' on-click='IncludeGenre'/>
	<horizontal child-expand-width='false'>
		<clickable-text id='excludeButton' text='❌' font-size='3.5' align="Center" on-click='ExcludeGenre' hover-hint='이 장르 태그가 지정된 모든 맵을 명시적으로 제외합니다'/>
	</horizontal>
</horizontal>